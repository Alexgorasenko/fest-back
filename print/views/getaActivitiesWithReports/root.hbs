<link rel="stylesheet" href="/assets/activities.css" />

<div class="page" id="sharable">
    <div class="signature">
        <div class="cell">
            <div>«‎УТВЕРЖДАЮ»</div>
            <div>{{signatures.top.position}} {{signatures.top.orgName}}</div>
            <div class="sign">
                <div></div>
                <div></div>
            </div>
            <div class="hints">
                <div>
                    <span>подпись</span>
                    <div class="stamp">М.П.</div>
                </div>
                <div>
                    <span>Ф.И.О руководителя</span>
                </div>
            </div>
        </div>
    </div>

    <div class="top">
        <div class="title">{{descriptionForReports}}</div>
        <div class="subtitle">{{nomination}}</div>
    </div>

    <div class="table">
        <div class="table-row _head">
            {{#each head as |column|}}
                <div class="column-head" style="width: {{column.width}}%">
                    <span>{{column.content}}</span>
                    {{#if column.levels}}
                        <div class="level-groups">
                            {{#each column.levels as |level|}}
                                <div class="level-group" style="width: {{level.width}}%">
                                    <span>Уровень образования: {{level.content}}</span>
                                    <div class="level-group-split">
                                        {{#each level.subcolumns as |sub|}}
                                            <div style="width: {{sub.width}}%">
                                                <span>{{sub.content}}</span>
                                            </div>
                                        {{/each}}
                                    </div>
                                </div>
                            {{/each}}
                        </div>
                    {{/if}}
                </div>
            {{/each}}
        </div>

        {{#each activities as |item|}}
            <div class="table-row values-row">
                {{#each item as |col|}}
                    <div style="width: {{col.width}}%" class="{{col.cellClass}}">
                        {{#if col.value}}
                            <span>{{col.value}}</span>
                        {{/if}}

                        {{#if col.levels}}
                            <div class="level-groups">
                                {{#each col.levels as |level|}}
                                    <div class="level-group" style="width: {{level.width}}%">
                                        <div class="level-group-split">
                                        {{#each level.subcolumns as |sub|}}
                                            <div style="width: {{sub.width}}%">{{sub.content}}</div>
                                        {{/each}}
                                        </div>
                                    </div>
                                {{/each}}
                            </div>
                        {{/if}}
                    </div>
                {{/each}}
            </div>
        {{/each}}

        {{#each extras as |row|}}
            <div class="table-row values-row">
                <div class="extra-label">{{row.label}}</div>
                <div class="extra-values">
                    {{#each row.cells as |cell|}}
                        <div style="width: {{cell.width}}%">
                            <span>{{cell.value}}</span>
                        </div>
                    {{/each}}
                </div>
            </div>
        {{/each}}

        <div class="table-row total-row">
            <div class="total-label">ИТОГО:</div>
            <div class="total-value">{{total}}</div>
            </div>
        </div>
    </div>

    <div class="bottom-signature">
        <div>Ответственное лицо за проведения мероприятий </div>
        <div class="sign">
            <div></div>
            <div class="name"> / {{signatures.bottom.name}}</div>
        </div>
    </div>
</div>
