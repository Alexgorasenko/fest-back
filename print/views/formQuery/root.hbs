<link rel="stylesheet" href="/assets/form.css" />

<div class="page" id="sharable">
    <div class="top">
        <div class="title">{{queryTitle}}</br>{{#if querySubTitle}}{{querySubTitle}}{{/if}}</div>
    </div>

    <div class="table">
        <table border="1" cellpadding="3">
            <tbody>
                <tr>
                    <td class="center bold" width="3%">№ п/п</td>
                    <td class="center bold" colspan="2" width="40%">Образовательная организация (общая информация)</td>
                    <td class="center bold" width="28.5%">Контактные лица, ответственные за проведение Фестиваля в организации (ФИО, моб.тел, E-mail)</td>
                    <td class="center bold" width="28.5%" colspan="2">
                        <table>
                            <tr class="divided">
                                <td class="center bold" colspan="2">Количество обучающихся в организации</td>
                            </tr>
                            <tr>
                                <td width="50%" class="center bold right-border">Уровень образования</td>
                                <td width="50%" class="center bold">Количество, чел. (девочки/мальчики)</td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <tr>
                    <td class="center bold">1</td>
                    <td class="bold" width="20%">Субъект РФ</td>
                    <td class="center" width="20%">
                        {{#if region}}
                            {{region.name}}
                        {{else}}
                            !Регион не указан!
                        {{/if}}
                    </td>
                    <td width="28.5%" class="center" rowspan="6">
                        {{#if contactPerson}}
                            {{contactPerson.fullname}}<br><br>
                            {{contactPerson.phone}}<br><br>
                            {{contactPerson.email}}<br>
                        {{/if}}
                    </td>
                    <td class="center" width="14.25%">
                        {{#if levels.[0]}}
                          {{levels.[0].name}}
                        {{else}}
                          Дошкольники
                        {{/if}}
                    </td>
                    <td class="center" width="14.25%">
                        {{#if levels.[0]}}
                          {{levels.[0].students}}
                        {{else}}
                          0 (0/0)
                        {{/if}}
                    </td>
                </tr>

                <tr>
                    <td class="center bold">2</td>
                    <td class="bold" width="20%">Полное наименование организации</td>
                    <td class="center" width="20%">
                        {{#if organizationFullName}}
                            {{organizationFullName}}
                        {{else}}
                            !Название не указано!
                        {{/if}}
                    </td>
                    <td class="center" width="14.25%">
                        {{#if levels.[1]}}
                          {{levels.[1].name}}
                        {{else}}
                          1-4 классы
                        {{/if}}
                    </td>
                    <td class="center" width="14.25%">
                        {{#if levels.[1]}}
                          {{levels.[1].students}}
                        {{else}}
                          0 (0/0)
                        {{/if}}
                    </td>
                </tr>

                <tr>
                    <td class="center bold">3</td>
                    <td class="bold" width="20%">Почтовый адрес</td>
                    <td class="center" width="20%">
                        {{#if address}}
                            {{address}}
                        {{else}}
                            !Адрес не указан!
                        {{/if}}
                    </td>
                    <td class="center" width="14.25%">
                        {{#if levels.[2]}}
                          {{levels.[2].name}}
                        {{else}}
                          5-9 классы
                        {{/if}}
                    </td>
                    <td class="center" width="14.25%">
                        {{#if levels.[2]}}
                          {{levels.[2].students}}
                        {{else}}
                          0 (0/0)
                        {{/if}}
                    </td>
                </tr>

                <tr>
                    <td class="center bold">4</td>
                    <td class="bold" width="20%">Официальный сайт</td>
                    <td class="center" width="20%">
                        {{#if site}}
                            {{site}}
                        {{else}}
                            !Сайт не указан!
                        {{/if}}
                    </td>
                    <td class="center" rowspan="3"  width="14.25%">
                        {{#if levels.[3]}}
                          {{levels.[3].name}}
                        {{else}}
                          10-11 классы
                        {{/if}}
                    </td>
                    <td class="center" rowspan="3" width="14.25%">
                        {{#if levels.[3]}}
                          {{levels.[3].students}}
                        {{else}}
                          0 (0/0)
                        {{/if}}
                    </td>
                </tr>

                <tr>
                    <td class="center bold">5</td>
                    <td class="bold" width="20%">Количество обучающихся</td>
                    <td class="center" width="20%">{{students.all}} ({{students.woman}}/{{students.man}})</td>
                </tr>

                <tr>
                    <td class="center bold">6</td>
                    <td class="bold" width="20%">Реквизиты организации</td>
                    <td class="center" width="20%">
                        {{#if requisites}}
                            <table width="100%">
                                <tr class="divided">
                                    <td width="30%">ИНН</td>
                                    <td>{{requisites.inn}}</td>
                                </tr>
                                <tr class="divided">
                                    <td width="30%">КПП</td>
                                    <td>{{requisites.kpp}}</td>
                                </tr>
                                <tr>
                                    <td width="30%">ОГРН</td>
                                    <td>{{requisites.ogrn}}</td>
                                </tr>
                            </table>
                        {{else}}
                            !Реквизиты не указаны!
                        {{/if}}

                    </td>
                </tr>

                <tr class="executive">
                    <td></td>
                    <td colspan="2"><b>Утверждаю:</b> Руководитель образовательной организации</td>
                    <td class="center">___________________________________<div><b>М.П.</b></div></td>
                    <td colspan="2"><u>/
                        {{#if director}}
                            <b>{{director}}</b>
                        {{else}}
                            !Руководитель не указан!
                        {{/if}}/</u>
                        <div><b>Ф.И.О.(полностью)</b></div>
                    </td>
                </tr>

                <tr class="executive creds">
                    <td></td>
                    <td class="right">Раб.тел:</br>E-mail:</td>
                    <td><span>
                        {{#if phone}}
                            {{phone}}
                        {{else}}
                            !номер не указан!
                        {{/if}}</span></br><span>{{#if email}}
                            {{email}}
                        {{else}}
                            !email не указан!
                        {{/if}}</span></td>
                        <td></td>
                    <td colspan=2>Дата: <span>{{date}}</span></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="bottom">
    </div>
</div>
